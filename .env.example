# Django Settings
SECRET_KEY=django-insecure-education-portal-production-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite if DB_NAME is not set, or uses PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=education_news_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Scraper Settings
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 EduNewsBot/1.0
SCRAPER_TIMEOUT_SECONDS=15
AUTO_PUBLISH_DEFAULT=True
