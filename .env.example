# =================================================================
# EDUGOV NEWS & NOTIFICATIONS PORTAL ENVIRONMENT SETTINGS
# =================================================================

APP_NAME="EduGov News"
APP_URL="http://127.0.0.1:8000"
APP_ENV="production"
APP_DEBUG=false

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# Set DB_DRIVER="sqlite" for zero-config local testing
# Set DB_DRIVER="mysql" for cPanel / Hostinger shared hosting
# -----------------------------------------------------------------
DB_DRIVER="mysql"

DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="edugov_db"
DB_USERNAME="edugov_user"
DB_PASSWORD="your_mysql_password"

# -----------------------------------------------------------------
# ADMIN CREDENTIALS
# Default login credentials for /admin
# -----------------------------------------------------------------
ADMIN_USER="admin"
ADMIN_PASS="admin123"
